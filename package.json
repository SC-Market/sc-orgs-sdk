{
  "name": "@sc-orgs/sdk",
  "version": "0.1.0",
  "description": "Typed client for the SC Orgs public API, with webhook signature verification (Star Citizen org hub).",
  "license": "MIT",
  "author": "SC Orgs (https://sc-orgs.space)",
  "homepage": "https://github.com/SC-Market/sc-orgs-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SC-Market/sc-orgs-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/SC-Market/sc-orgs-sdk/issues"
  },
  "keywords": [
    "star-citizen",
    "sc-orgs",
    "api",
    "sdk",
    "openapi",
    "webhooks",
    "standard-webhooks"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!**/._*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:offline": "node scripts/generate.mjs --offline",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
