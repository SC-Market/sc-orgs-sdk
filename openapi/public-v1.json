      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "sco_live_… or sco_test_…",
        "description": "An org API key, created in Manage → API: Authorization: Bearer sco_live_…. Keys act for their organization within the scopes listed on each operation."
      }
    }
