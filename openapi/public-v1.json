  "info": {
    "title": "SC Orgs Public API",
    "version": "1.0.0",
    "description": "Read your organization's profile, roster, roles, events and RSVPs with an org API key, and get webhooks when they change. Guide and examples: https://sc-orgs.space/developers",
    "license": {
      "name": "MIT"
    },
    "contact": {
      "name": "SC Orgs",
      "url": "https://sc-orgs.space/developers"
    }
  },
  "paths": {
    "/orgs/{org}": {
      "get": {
        "operationId": "GetOrganization",
        "responses": {
          "200": {
            "description": "The organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationResponse"
                },
                "examples": {
                  "Example 1": {
                    "value": {
                      "data": {
                        "id": "4b2c0000-0000-4000-8000-000000000002",
                        "sid": "HRMS",
                        "name": "Hermes Logistics",
                        "logo_url": null,
                        "banner_url": null,
                        "headline": "Hauling and escort",
                        "description": "We move cargo.",
                        "languages": [
                          "en"
                        ],
                        "playstyle_tags": [
                          "casual"
                        ],
                        "focus_tags": [
                          "trading"
                        ],
                        "member_count": 12,
                        "rating": {
                          "average": 4.5,
                          "count": 8
                        },
                        "discord_url": null,
                        "website_url": null,
                        "url": "https://sc-orgs.space/communities/HRMS",
                        "rsi_url": "https://robertsspaceindustries.com/orgs/HRMS",
                        "created_at": "2026-10-20T12:00:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorResponse"
                }
              }
            }
          }
        },
        "description": "The org's profile. Anonymous callers get its public fields; a key with\n`org:read` adds the member view (member count including hidden members,\nowner, Discord link status). Test-realm orgs (like the sandbox) are only\nvisible to their own keys.",
        "summary": "Get an organization",
        "tags": [
          "Public: Organizations"
        ],
        "security": [
          {
            "apiKey": [
              "org:read"
            ]
          },
          {}
        ],
        "parameters": [
          {
            "in": "path",
            "name": "org",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/orgs/{org}/members": {
      "get": {
        "operationId": "ListMembers",
        "responses": {
          "200": {
            "description": "A page of members",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberListResponse"
                },
                "examples": {
                  "Example 1": {
                    "value": {
                      "data": {
                        "members": [
                          {
                            "id": "a1d30000-0000-4000-8000-000000000003",
                            "rsi_handle": "~alice",
                            "avatar_url": null,
                            "is_hidden": false,
                            "roles": [
                              {
                                "id": "r0000000-0000-4000-8000-000000000080",
                                "name": "Admin",
                                "rank": 80
                              }
                            ],
                            "ranks": [
                              {
                                "track": "Pilot",
                                "rank": "Lieutenant",
                                "tier": 3,
                                "icon_url": null
                              }
                            ],
                            "joined_at": "2026-10-20T12:05:00.000Z"
                          }
                        ],
                        "total": 14,
                        "page": 1,
                        "page_size": 25
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The key lacks members:read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicErrorResponse"
                }
              }
            }
          }
        },
        "description": "The roster, sorted by join date. Hidden members are included (they hide\nfrom the public, not from the org). Never includes Discord ids, last\nactivity or any account details.",
        "summary": "List members",
        "tags": [
          "Public: Members"
        ],
        "security": [
          {
            "apiKey": [
              "members:read"
            ]
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "org",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page number, from 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "1-100 (default 25); larger values are clamped to 100.",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Only members holding this role.",
            "in": "query",
            "name": "role_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only members who joined at or after this time (ISO 8601).",
            "in": "query",
            "name": "joined_since",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Handle prefix, at least 3 characters.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/orgs/{org}/members/{member}": {
      "get": {
        "operationId": "GetMember",
        "responses": {
          "200": {
            "description": "The member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberResponse"
                },
                "examples": {
                  "Example 1": {
